# Copy to .env and fill before deploy.

# ── AWS ECR (EC2 production) ────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=123456789012
IMAGE_TAG=latest
# Full registry host (no trailing slash):
ECR_REGISTRY=123456789012.dkr.ecr.ap-south-1.amazonaws.com

# ── Supabase (required for auth + persistence) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# LLM providers (optional — ARIA chat fallbacks)
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Report email (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
